# ===========================================
# Flutter 잔재 제거 후 재진입 방지
# ===========================================
# Flutter 빌드 폴더 (RN으로 전환 — 더이상 필요 없음)
flutter/
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/

# Flutter 플랫폼 폴더 (RN 자체 생성과 다름)
# RN 셋업 시 app/android, app/ios 로 생성 예정

# ===========================================
# Flutter 잔재 - 재진입 방지 (v2는 RN)
# ===========================================
# Flutter 빌드/캐시
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/
flutter/

# Flutter 플랫폼 폴더는 RN의 app/ios, app/android와 충돌 방지를 위해 무시
# (실제 RN 폴더는 app/ 아래 생성됨)
/android/
/ios/
/linux/
/macos/
/windows/
/web/
/lib/
/test/
# ⚠️ 디렉터리 자체(`/assets/`)를 무시하면 git 이 안으로 들어가지 않아
#    안쪽 파일을 `!` 로 되살릴 수 없다. **내용물**을 무시해야 예외가 먹는다.
/assets/*
# 앱 아이콘 원본만은 저장소에 둔다 — 이 파일 하나에서 iOS/Android 아이콘을 전부 만든다
# (tools/make_app_icons.py · docs/12_APP_ICON.md)
!/assets/app-icon-1024.png
/build/

# 마이그레이션 스크립트는 v2에서 사용 안 함
# (필요 시 main 브랜치에서 참조)

# Apple DeviceCheck 개인키 — 저장소에 두지 말 것
*.p8
