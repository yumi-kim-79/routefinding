rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // RouteFinding v2 — 4탭 체제 (개념도 / 지도 / 루트제보 / 마이페이지)
    // 정리일: 2026-08-04
    //
    // 관리자 = yusung790926@gmail.com  (TODO: Custom Claims로 이전)
    // ═══════════════════════════════════════════════════════════════

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'yusung790926@gmail.com';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ───────────────────────────────────────────────────────────────
    // 1) users/{userId} — 프로필 (닉네임 / 사진 / 한 줄 소개 / FCM 토큰)
    //
    // ⚠️ 변경: 기존 `allow read: if true` → 로그인 필요.
    //    이메일·FCM 토큰이 들어 있는 문서가 누구에게나 열려 있었다.
    //
    // ⚠️⚠️ "동작에는 영향이 없다"고 적어 뒀던 것은 **틀렸다** (2026-08-06 실측).
    //    **회원가입의 닉네임 중복 확인은 로그인 전에 일어난다.** 이 규칙 때문에
    //    조회가 거부돼 "닉네임 확인 중 오류" 만 뜨고 **신규 가입이 전면 차단돼 있었다.**
    //    → 규칙은 그대로 두고, 서버(Cloud Functions `checkNickname`)가 확인해
    //      불리언만 돌려주도록 바꿨다. 여기를 다시 열지 말 것 — 이메일이 노출된다.
    match /users/{userId} {
      /*
       * 문서 하나 읽기 — 로그인한 사용자면 누구나.
       * 커뮤니티가 글쓴이의 닉네임·프로필 사진을 읽어야 하므로 막을 수 없다.
       */
      allow get: if isSignedIn();

      /*
       * 🚨 **목록 조회는 관리자만.** (2026-09-30)
       *    전에는 `allow read: if isSignedIn()` 이라 **로그인한 누구나 users 컬렉션을
       *    통째로 쿼리해 전체 회원의 이메일을 긁어갈 수 있었다.**
       *    개인정보처리방침 3항은 "이메일 주소는 다른 이용자에게 공개되지 않습니다"라고
       *    적어 놨는데 규칙이 그것을 막고 있지 않았다 — 실제 유출 경로였다.
       *
       * ⚠️ 앱에는 `users` 최상위 컬렉션을 목록으로 읽는 코드가 **한 군데도 없다**
       *    (전부 문서 단건이거나 `users/{uid}/...` 서브컬렉션). 확인하고 좁혔다.
       *    새로 목록이 필요해지면 이 줄을 푸는 게 아니라 필요한 필드만 담은
       *    공개용 컬렉션을 따로 두는 쪽을 먼저 검토할 것.
       */
      allow list: if isAdmin();

      allow write: if isOwner(userId) || isAdmin();
    }

    // 1-1) 즐겨찾기 (개념도 ★ 버튼)
    match /users/{userId}/my_routes/{routeId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // 1-1-b) 프로젝트 — 도전 중인 루트 (v2.2.0)
    //   ⚠️ 즐겨찾기와 다른 것이다: 즐겨찾기 = 가보고 싶다 / 프로젝트 = 아직 못 깼다.
    //      완등을 기록하면 앱이 여기서 지운다 (services/projectService.ts).
    match /users/{userId}/my_projects/{routeId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // 1-2) 등반일지 — 날짜별 1건. 나중에 고칠 수 있어야 하므로 update 포함.
    match /users/{userId}/climbing_logs/{logId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // ───────────────────────────────────────────────────────────────
    // 2) route_reports — 자연암벽(리드). 개념도·지도·루트제보의 원천 데이터.
    //
    //   읽기: 승인된 루트는 비로그인도 조회 가능(웹 지도/개념도 공개용).
    //         그 외에는 작성자 본인 또는 관리자.
    //
    //   ⚠️ 2026-09-07 정책 변경: 제보가 **승인 없이 바로 게시**된다
    //      (app/src/services/reportService.ts 머리말).
    //      그래서 예전의 "승인된 건 작성자가 못 고친다" 규칙을 그대로 두면
    //      **올린 사람이 자기 오타조차 못 고치게 된다.** 작성자 수정을 열어 준다.
    //   ⚠️ 단, `status` 와 `authorUid` 는 작성자가 못 바꾼다 —
    //      반려된 글을 스스로 되살리거나 남의 글로 만들 수 있으면 안 된다.
    match /route_reports/{reportId} {
      allow read:
        if resource.data.status == 'approved'
        || isOwner(resource.data.authorUid)
        || isAdmin();

      allow create:
        if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // 작성자는 내용만, 관리자는 전부
      //
      // ⚠️ 완등 통계(sendCount/ratingSum/ratingCount)는 **Cloud Function `countSend` 만** 쓴다.
      //    여기서 막지 않으면 작성자가 자기 루트의 완등 수를 마음대로 올릴 수 있다
      //    (Admin SDK 는 규칙을 우회하므로 Function 은 영향받지 않는다).
      allow update:
        if isAdmin()
        || (isOwner(resource.data.authorUid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.authorUid == resource.data.authorUid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['sendCount', 'ratingSum', 'ratingCount', 'closure']));

      /*
       * 베타 영상 — **로그인 사용자 누구나** 붙이고 뗄 수 있다 (v2.2.0).
       * ⚠️ 루트를 올린 사람만 붙일 수 있으면 아무도 안 붙인다.
       * ⚠️ `betaVideos` **한 필드만** 바뀌는 경우로 못 박는다.
       *    이 조건이 없으면 이 규칙 하나로 루트 전체를 아무나 고칠 수 있게 된다.
       */
      allow update:
        if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['betaVideos'])
        && request.resource.data.betaVideos.size() <= 10;

      allow delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    match /route_reports/{reportId}/pitches/{pitchId} {
      allow read: if isSignedIn();
      allow create:
        if isSignedIn()
        && (
          request.resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/route_reports/$(reportId)).data.authorUid == request.auth.uid
          || isAdmin()
        );
      allow update, delete:
        if isOwner(resource.data.authorUid)
        || get(/databases/$(database)/documents/route_reports/$(reportId)).data.authorUid == request.auth.uid
        || isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 3) bouldering_reports — 인공벽/볼더링. route_reports와 동일 정책.
    match /bouldering_reports/{reportId} {
      allow read:
        if resource.data.status == 'approved'
        || isOwner(resource.data.authorUid)
        || isAdmin();

      allow create:
        if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // route_reports 와 같은 이유로 작성자 수정을 연다 (위 §2 머리말)
      allow update:
        if isAdmin()
        || (isOwner(resource.data.authorUid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.authorUid == resource.data.authorUid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['sendCount', 'ratingSum', 'ratingCount', 'closure']));

      allow delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    match /bouldering_reports/{reportId}/pitches/{pitchId} {
      allow read: if isSignedIn();
      allow create:
        if isSignedIn()
        && (
          request.resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/bouldering_reports/$(reportId)).data.authorUid == request.auth.uid
          || isAdmin()
        );
      allow update, delete:
        if isOwner(resource.data.authorUid)
        || get(/databases/$(database)/documents/bouldering_reports/$(reportId)).data.authorUid == request.auth.uid
        || isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 4) concept_photos — 개념도 사진 + 그 위에 그린 라인/텍스트 (v2 신규)
    //
    //   승인 전(pending)에는 **올린 본인과 관리자만** 조회된다.
    //   create에서 status를 'pending'으로 강제해 스스로 승인하는 것을 막는다.
    match /concept_photos/{photoId} {
      allow read:
        if isSignedIn()
        && (
          resource.data.status == 'approved'
          || resource.data.authorUid == request.auth.uid
          || isAdmin()
        );

      allow create:
        if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // 승인된 건 본인도 못 고친다 (관리자만)
      allow update, delete:
        if isAdmin()
        || (isOwner(resource.data.authorUid) && resource.data.status != 'approved');
    }

    // ───────────────────────────────────────────────────────────────
    // 4-1) user_messages — 사용자 → 관리자 문의 (v2 신규, 2026-08-17)
    //
    //   앱 안에서 기능개선·수정요청을 받는다.
    //   사용자: 마이페이지 ▸ 문의    관리자: 마이페이지 ▸ 사용자 메시지
    //
    //   ⚠️ 관리자 목록 화면은 orderBy('createdAt') 로 **컬렉션 전체**를 조회한다.
    //      쿼리는 규칙으로 문서를 하나씩 거르지 못하고, 조건에 맞지 않는 문서가
    //      결과에 하나라도 있으면 **쿼리 전체가 거부**된다.
    //      그래서 list(전체 조회)는 관리자만, 개인은 authorUid 로 좁힌 쿼리만 통과시킨다.
    match /user_messages/{messageId} {
      // 문서 하나 읽기 — 본인 또는 관리자
      allow get:
        if isAdmin() || isOwner(resource.data.authorUid);

      // 목록 조회 — 관리자는 전체, 사용자는 자기 것으로 좁힌 쿼리만
      //
      // ⚠️ `request.query.limit` 조건은 넣지 않았다. 앱 쿼리에 limit 이 없어서
      //    조건을 걸면 정상 조회까지 막힌다. 대신 아래 resource 조건이
      //    "authorUid 로 좁히지 않은 쿼리"를 전부 거부한다.
      allow list:
        if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // 보내기 — 남의 이름으로 못 보내고, 스스로 답변 완료로 만들 수 없다
      allow create:
        if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && !('reply' in request.resource.data);

      // 답변·처리완료는 **관리자만**
      allow update: if isAdmin();

      // 삭제 — 본인이 보낸 것 또는 관리자
      allow delete:
        if isAdmin() || isOwner(resource.data.authorUid);
    }

    // ═══════════════════════════════════════════════════════════════
    // 4-2) 커뮤니티 — 2026-09-07 (v2.1.0)
    //
    //   게시판(boards) + 글(community_posts) + 댓글 + 신고 + 차단.
    //   하단탭의 '루트제보' 자리를 커뮤니티가 넘겨받았다.
    //
    //   ⚠️ Apple 심사지침 1.2(사용자 생성 콘텐츠)를 통과하려면
    //      **신고 · 차단 · 자동숨김 · 24시간 내 처리**가 전부 있어야 한다.
    //      아래 abuse_reports / blocked 규칙을 지우면 심사에서 반려된다.
    // ═══════════════════════════════════════════════════════════════

    // 게시판 목록 — 누구나 읽고, 만들고 고치는 건 관리자만.
    //
    // ⚠️ 앱은 `where('visible','==',true)` 없이 **컬렉션 전체**를 구독한다
    //    (services/boardService.ts 머리말: 시드 문서에 visible 이 빠져도 안 사라지게).
    //    그래서 read 를 문서 단위로 좁히면 **쿼리 전체가 거부**되어 탭이 하나도 안 뜬다.
    match /boards/{boardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 글
    match /community_posts/{postId} {
      // 읽기는 비로그인도 허용 — 웹에서 커뮤니티를 공개할 여지를 남긴다.
      allow read: if true;

      // 작성 — 남의 이름으로 못 쓰고, 카운터는 반드시 0에서 시작한다
      allow create:
        if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.boardId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000
        && request.resource.data.imageUrls.size() <= 5
        /*
         * ⚠️ 등반일지 게시판은 **사용자가 직접 못 쓴다.** 일지를 공개로 바꾸면
         *    Cloud Function `syncPublicLog` 이 만든다 (Admin SDK 는 규칙을 우회하므로
         *    이 조건은 서버에 영향을 주지 않는다). 앱의 writable=false 는 버튼만 가릴 뿐이라
         *    규칙에서도 한 번 더 막아야 한다.
         */
        && request.resource.data.boardId != 'log'
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.isDeleted == false;

      // (a) 본인 글 수정 — 작성자·카운터는 못 건드린다
      //
      // ⚠️ 등반일지 글은 본인도 여기서 못 고친다. 고쳐 봐야 일지를 다음에 저장할 때
      //    `syncPublicLog` 이 덮어써서 되돌아간다 — 고칠 곳은 일지 원본이다.
      allow update:
        if (isOwner(resource.data.authorUid) || isAdmin())
        && (resource.data.boardId != 'log' || isAdmin())
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.reportCount == resource.data.reportCount;

      // (b) 좋아요 — 아무나, 단 **자기 uid 하나만** 넣고 빼는 경우로 한정.
      //
      // ⚠️ `allow update` 를 여러 번 쓰는 것이 맞는 패턴이다. 하나로 합치려고
      //    || 로 이어 붙이면 조건이 서로 섞여 (a)에서 막아 둔 필드가 (b)로 뚫린다.
      allow update:
        if isSignedIn()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['likedBy', 'likeCount'])
        && (
             (request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.resource.data.likeCount == resource.data.likeCount + 1
              && request.auth.uid in request.resource.data.likedBy)
             ||
             (resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
              && request.resource.data.likeCount == resource.data.likeCount - 1
              && !(request.auth.uid in request.resource.data.likedBy))
           );

      // (c) 신고 누적 — reportCount 만 +1. abuse_reports 생성과 짝이다.
      allow update:
        if isSignedIn()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1;

      // ⚠️ 등반일지 글은 본인이 직접 못 지운다. 여기서 지우면 **일지는 여전히 공개 상태**라
      //    다음 저장 때 글이 되살아난다. 내리는 방법은 일지의 '공개' 스위치를 끄는 것이다.
      allow delete:
        if isAdmin()
        || (isOwner(resource.data.authorUid) && resource.data.boardId != 'log');

      // 댓글 — 대댓글 없음(1단계)
      //
      // ⚠️ `commentCount` 는 **Cloud Function(countCommunityComment)** 이 올린다.
      //    클라이언트가 올리면 위 (a)/(b)/(c) 어디에도 걸리지 않아 막을 수 없다.
      match /comments/{commentId} {
        allow read: if true;

        allow create:
          if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.reportCount == 0
          && request.resource.data.isDeleted == false;

        // 본문 수정 — 본인만
        allow update:
          if isOwner(resource.data.authorUid)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.reportCount == resource.data.reportCount;

        // 신고 누적
        allow update:
          if isSignedIn()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.reportCount + 1;

        allow delete: if isOwner(resource.data.authorUid) || isAdmin();
      }
    }

    // 신고 접수 — 낸 사람과 관리자만 본다.
    //
    // ⚠️ 목록(list)을 관리자만 허용하는 이유는 user_messages 와 같다:
    //    쿼리에 조건에 안 맞는 문서가 하나라도 걸리면 **쿼리 전체가 거부**된다.
    match /abuse_reports/{reportId} {
      allow get:  if isAdmin() || isOwner(resource.data.reporterUid);
      allow list: if isAdmin();

      allow create:
        if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'open';

      // 처리(숨김/무시/정지)는 관리자만 — 24시간 내 처리가 심사 요건이다
      allow update, delete: if isAdmin();
    }

    // 차단 목록 — 본인만 읽고 쓴다.
    //   차단하면 그 사용자의 글·댓글이 내 화면에서 사라진다(클라이언트 필터).
    match /users/{userId}/blocked/{blockedUid} {
      allow read, create, delete: if isOwner(userId);
    }

    // ───────────────────────────────────────────────────────────────
    // 4-3) difficulty_suggestions — 난이도 제안 (v2.2.0, 2026-09-07)
    //
    //   리드 루트의 97%에 난이도가 없다(실측). 본 사람이 알려주고,
    //   **같은 값이 3명 모이면 Cloud Function 이 반영**한다.
    //
    //   ⚠️ 문서 ID 는 `{conceptId}__{uid}` 로 고정돼 있다.
    //      아래 규칙이 그 형식을 강제해야 **한 사람이 여러 표를 만드는 것**을 막을 수 있다.
    match /difficulty_suggestions/{suggestionId} {
      // 읽기는 로그인 사용자면 된다 — 상세 화면에 "지금까지 5.10a 2표" 를 보여준다
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        // 문서 ID = conceptId + '__' + uid  (한 사람 한 표)
        && suggestionId == request.resource.data.conceptId + '__' + request.auth.uid
        && request.resource.data.value is string
        && request.resource.data.value.size() > 0
        && request.resource.data.value.size() <= 12
        && request.resource.data.conceptSource in ['route_reports', 'bouldering_reports'];

      // 본인 제안 철회, 관리자는 정리 가능
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 4-4) sends — 완등 기록 (v2.2.0, 2026-09-07)
    //
    //   ⚠️ 등반일지(users/{uid}/climbing_logs)와 **별개**다. 일지는 하루 단위,
    //      완등은 루트 단위 — 합치면 "이 루트 완등 N명"을 만들 수 없다.
    //   ⚠️ 개념도의 sendCount/ratingSum/ratingCount 는 Cloud Function 이 센다.
    //      위 §2 update 규칙에서 클라이언트 쓰기를 막아 두었다.
    match /sends/{sendId} {
      // 공개 기록은 누구나 (루트 상세의 '완등한 사람' 목록)
      //
      // 🚨 이 규칙을 쓰는 **목록 쿼리는 반드시 `where('isPublic','==',true)` 를 붙여야
      //    한다.** Firestore 는 list 쿼리를 결과가 아니라 쿼리 조건만 보고 판단한다.
      //    isPublic 을 안 거른 쿼리는 "비공개 문서가 섞일 수 있다"고 보고 통째로 거부한다.
      //
      //    관리자 계정은 `isAdmin()` 이 문서와 무관하게 참이라 이 규칙이 통째로
      //    통과한다. 그래서 **관리자로 시험하면 이 버그가 절대 안 보인다.**
      //    v2.2.0 이 정확히 그렇게 나갔다 (2026-09-08 사용자 제보 → v2.2.1 에서 수정).
      //    → services/sendService.ts 의 subscribeSendsOfConcept 머리말 참고.
      allow read:
        if resource.data.isPublic == true
        || isOwner(resource.data.uid)
        || isAdmin();

      allow create:
        if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.conceptId is string
        && request.resource.data.conceptSource in ['route_reports', 'bouldering_reports']
        && request.resource.data.style in
             ['onsight', 'flash', 'redpoint', 'toprope', 'second']
        && (!('rating' in request.resource.data)
            || (request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && (!('memo' in request.resource.data)
            || request.resource.data.memo.size() <= 300);

      // 본인 기록만 고치고 지운다. 관리자는 부적절한 메모를 지울 수 있어야 한다
      allow update:
        if (isOwner(resource.data.uid) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.conceptId == resource.data.conceptId
        && (!('rating' in request.resource.data)
            || (request.resource.data.rating >= 1 && request.resource.data.rating <= 5));

      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 4-5) crags — 암장 정보 (접근·주차·대중교통·현장 시설) — v2.2.0, 2026-09-07
    //
    //   ⚠️ 루트 문서에 넣지 않는 이유: 주차·화장실은 **암장의 속성**이다.
    //      루트마다 넣으면 선운산 도솔암 107개 루트에 같은 안내를 107번 쓰게 된다.
    //   ⚠️ 문서 ID = `{mountain}__{zone}` (app/src/types/crag.ts `cragIdOf`).
    //      앱과 웹이 같은 규칙을 써야 같은 문서를 가리킨다.
    // ───────────────────────────────────────────────────────────────
    // 실시간 접속 통계 — `stats_daily/{YYYY-MM-DD}` (2026-09-30)
    //
    //   🚨 **클라이언트는 절대 쓰지 못한다.** Cloud Function `countPresence` 만 쓴다
    //      (Admin SDK 는 규칙을 우회한다). 앱이 직접 increment 할 수 있으면
    //      "1씩만 올려라"를 규칙으로 강제할 방법이 없어 누구나 숫자를 조작한다.
    //
    //   ⚠️ 읽기도 관리자만. 접속자 수는 운영 지표지 공개 정보가 아니다.
    //      `allow list: if isAdmin()` 이라 쿼리에 조건을 더 붙이지 않아도 통과한다
    //      (완등 목록 사고와 다른 점 — CHANGELOG 66차).
    //
    //   ⚠️ 개인별 접속 로그는 만들지 않는다. 여기 쌓이는 것은 날짜별 숫자뿐이다.
    match /stats_daily/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /crags/{cragId} {
      // 접근 정보는 등반 안전과 직결된다 — 비로그인도 읽을 수 있어야 한다
      allow read: if true;

      /*
       * ⚠️ **로그인한 사용자면 누구나 채울 수 있다** (2026-09-07 정책).
       *    제보를 승인 없이 바로 올리기로 한 결정과 같은 방향이다 —
       *    관리자 혼자 967개 구역의 접근 정보를 채울 수는 없다.
       *    잘못된 값은 지우면 되지만, 아무도 못 쓰면 정보 자체가 안 생긴다.
       * ⚠️ 대신 누가 무엇을 바꿨는지 아래 `edits` 에 남는다. 그게 사후 관리의 근거다.
       */
      /*
       * 🚨 `closure`(구역 폐쇄)는 **관리자만** 쓴다.
       *    나머지 접근 정보와 달리 이건 공동 편집 대상이 아니다.
       *    누구나 쓸 수 있으면 장난으로 '인수봉 전체 폐쇄'를 걸어 그 구역 모든 루트에
       *    안내를 띄울 수 있고, 반대로 **진짜 폐쇄를 아무나 풀어 버릴 수도 있다.**
       *    (2026-09-15 폐쇄 기능을 넣으면서 발견 — 그 전까지는 필드 자체가 없었다)
       *
       * ⚠️ create 와 update 를 나눈 이유: create 에는 `resource` 가 없어
       *    `diff(resource.data)` 가 그대로 터진다.
       */
      allow create:
        if isSignedIn()
        && (isAdmin() || !('closure' in request.resource.data));

      allow update:
        if isSignedIn()
        && (isAdmin()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['closure']));

      // 문서 자체를 없애는 것은 관리자만 — 실수로 지우면 복구할 방법이 없다
      allow delete: if isAdmin();

      /*
       * 편집 이력 — **덧붙이기만 된다.**
       * ⚠️ 고치거나 지울 수 있으면 이력이 아니다. 되돌릴 근거가 사라진다.
       */
      match /edits/{editId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ───────────────────────────────────────────────────────────────
    // 4-6) edit_suggestions — 정보 수정 제안 (v2.2.0, 2026-09-07)
    //
    //   ⚠️ 암장 정보(`crags`)는 누구나 바로 고칠 수 있게 열었지만,
    //      **루트 문서는 검토를 거친다.** 지도·목록·완등 기록이 전부 여기에 매달려 있어
    //      한 사람이 잘못 고치면 화면이 통째로 어긋난다.
    //   ⚠️ 본인 제보는 제안 없이 바로 고친다 (§2 의 작성자 update 규칙).
    match /edit_suggestions/{id} {
      allow get:  if isAdmin() || isOwner(resource.data.uid);
      // 목록은 관리자만 — 조건에 안 맞는 문서가 하나라도 섞이면 쿼리 전체가 거부된다
      allow list: if isAdmin();

      allow create:
        if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.conceptSource in ['route_reports', 'bouldering_reports'];

      // 반영·반려는 관리자만
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 5) notifications — FCM 알림 히스토리 (앱 Phase 3에서 사용 예정)
    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner(resource.data.receiverId);
      allow create: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // 6) 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // 제거한 규칙 (2026-08-04) — 해당 기능이 v2에서 빠졌거나 미사용
    //
    //   announcements            공지사항(웹)      — 코드 참조 0
    //   posts_summary            게시판 개요       — 코드 참조 0
    //   user_drafts              제보 초안         — 코드 참조 0
    //   users/{uid}/my_comments  내 댓글           — 코드 참조 0
    //   users/{uid}/comments     내 댓글           — 코드 참조 0
    //   concepts/{산}/routes     구 개념도         — 실제로는 route_reports를 쓴다
    //   posts + comments + replies + likes         — 게시판 제거
    //   crews/**                                   — 크루 제거
    //   {path=**}/comments, {path=**}/likes        — 위 기능 전용 와일드카드
    //   route_gpx/**             Storage 경로가 Firestore 규칙에 잘못 들어가 있었다.
    //                            (storage.rules에 같은 규칙이 이미 있어 영향 없음)
    //   조회수/좋아요용 request.writeFields 규칙
    //                            rules v2에 없는 API라 항상 거부되던 죽은 규칙.
    //                            게시판 제거와 함께 삭제.
    //
    // 데이터는 지워지지 않는다. 게시판·크루를 되살릴 때 규칙만 다시 넣으면 된다.
    // ═══════════════════════════════════════════════════════════════
  }
}
