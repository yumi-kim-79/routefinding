# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# ─────────────────────────────────────────────────────────────────────────
# React Native Firebase iOS 설정 (2026-08-04 정정)
#
# 이전: `use_modular_headers!` 를 전역으로 켰다.
#   → 최초 에러("Swift pods cannot yet be integrated as static libraries")는
#     넘겼지만, 전역 모듈 헤더는 gRPC-Core의 헤더 배치와 맞지 않아
#     `Pods/Headers/Private/grpc/gRPC-Core.modulemap not found` 로 이어졌다.
#     (docs/06_iOS_BUILD_NOTES.md §2의 1·3차 실패 — 패치로 덧대던 원인)
#
# 현재: RNFB 공식 권장(rnfirebase.io)인 **static framework 링크**를 쓴다.
#   `$RNFirebaseAsStaticFramework = true` 는 static framework 사용 시 필수 전역이다.
#
# 되돌리려면: 이 블록을 지우고 `use_modular_headers!` 를 복구한 뒤
#             `cd ios && rm -rf Pods Podfile.lock && pod install`
# ─────────────────────────────────────────────────────────────────────────
$RNFirebaseAsStaticFramework = true

# ─────────────────────────────────────────────────────────────────────────
# AdMob (react-native-google-mobile-ads) — 2026-08-05
#
# 이 Podfile은 위 RNFB 때문에 `use_frameworks! :linkage => :static`을 쓴다.
# RNGoogleMobileAds의 podspec 기본값은 `static_framework = false`라서, 그대로 두면
# 링크 방식이 어긋나 심볼을 못 찾는 일이 생긴다. RNFB와 **같은 방식으로 맞춰 준다.**
#
# 앱 ID(GADApplicationIdentifier)는 여기가 아니라 **app.json**에서 읽어
# CocoaPods가 심어 놓는 빌드 스크립트가 Info.plist에 넣는다 (RNFB의 firebase.json과 같은 방식).
#   → app.json 의 "react-native-google-mobile-ads".ios_app_id
#   ⚠️ app.json을 고친 뒤에는 반드시 `pod install`을 다시 돌려야 반영된다.
# ─────────────────────────────────────────────────────────────────────────
$RNGoogleMobileAdsAsStaticFramework = true

# USE_FRAMEWORKS 환경변수로 재정의 가능. 기본값 static.
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'RouteFinding' do
  config = use_native_modules!

  # ── 지도 (2026-08-04) ────────────────────────────────────────────────
  # react-native-maps의 iOS 기본값은 **애플 지도**다. 웹·안드로이드와 같은 지도를
  # 보여주려면 Google 서브스펙을 명시해야 한다(GoogleMaps 9.4.0 + Maps-iOS-Utils).
  #
  # ⚠️ 이 Podfile은 RNFB 때문에 `use_frameworks! :linkage => :static`을 쓴다.
  #    구글 지도 pod과 충돌해 빌드가 깨지면 **아래 두 줄을 지우고 pod install**하면
  #    애플 지도로 즉시 되돌아간다 (JS는 constants/map.ts의 MAP_PROVIDER만 수정).
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'RouteFindingTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ── gRPC 빌드 패치: RNFB 25 업그레이드(2026-08-04)와 함께 **제거** ──
    #
    # 배경: Xcode 26.x의 C++20 explicit modules와 gRPC-C++ pod이 충돌해
    #       빌드가 깨졌고(docs/06_iOS_BUILD_NOTES.md), 임시로 아래 패치를 넣었다.
    #       패치를 한 겹 벗길 때마다 다음 불일치가 드러나는 "양파 까기"였다.
    #
    # 해소: RNFB 25가 쓰는 firebase-ios-sdk 12.12.0+ 는 공식적으로
    #       **Xcode 26.2 이상을 요구**한다 = 생태계가 정식 대응했다는 뜻.
    #       따라서 이 패치는 불필요할 뿐 아니라, 남겨두면 오히려 방해가 된다.
    #
    # 만약 빌드가 다시 깨지면 아래 주석을 되살리고 에러 원문을
    # docs/06_iOS_BUILD_NOTES.md §2 표에 추가할 것 (임의 패치 추가 금지).
    #
    # installer.pods_project.targets.each do |target|
    #   if %w[gRPC-C++ gRPC-Core BoringSSL-GRPC].include?(target.name)
    #     target.build_configurations.each do |bc|
    #       bc.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
    #     end
    #   end
    # end
  end
end
