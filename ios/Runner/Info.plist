<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!--
      iOS 13 이상: “앱 사용 중” 위치 권한 요청 시 표시되는 문구
    -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>앱 사용 중에도 위치 정보를 수집하여 트래킹 경로를 기록합니다.</string>

    <!--
      iOS 13 이상: “항상” 권한(백그라운드 위치 접근 포함) 요청 시 표시되는 문구
    -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>앱이 백그라운드에 있을 때도 위치 정보를 수집하여 트래킹을 계속 기록합니다.</string>

    <!--
      iOS 12 이하 호환성: “항상” 권한 요청 시 표시되는 문구
    -->
    <key>NSLocationAlwaysUsageDescription</key>
    <string>앱이 백그라운드에 있을 때도 위치 정보를 수집하여 트래킹을 계속 기록합니다.</string>

    <!--
      아래 UIBackgroundModes 추가로
      백그라운드 상태에서도 위치 업데이트를 계속 받도록 허용합니다.
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>

    <!--
      CADisableMinimumFrameDurationOnPhone:
      iOS 디바이스의 화면 frame rate 제한을 해제하여
      Flutter 애니메이션이 부드럽게 표시되도록 합니다.
    -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <!--
      CFBundleDevelopmentRegion:
      앱의 기본 지역(언어) 설정으로,
      Xcode에서 지정한 기본 언어를 따릅니다.
    -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <!--
      CFBundleDisplayName:
      홈 화면에 표시되는 앱 이름
    -->
    <key>CFBundleDisplayName</key>
    <string>RouteFinding</string>

    <!--
      CFBundleExecutable:
      실행 파일 이름(자동 대체)
    -->
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!--
      CFBundleIdentifier:
      앱의 번들 식별자
    -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <!--
      CFBundleInfoDictionaryVersion:
      Info.plist 버전(보통 6.0)
    -->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!--
      CFBundleName:
      번들 이름
    -->
    <key>CFBundleName</key>
    <string>RouteFinding</string>

    <!--
      CFBundlePackageType:
      ‘APPL’은 일반 iOS 앱
    -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!--
      CFBundleShortVersionString:
      사용자에게 보이는 버전(FLUTTER_BUILD_NAME)
    -->
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <!--
      CFBundleSignature:
      번들의 서명 시그니처(????)
    -->
    <key>CFBundleSignature</key>
    <string>????</string>

    <!--
      CFBundleVersion:
      내부 빌드 번호(FLUTTER_BUILD_NUMBER)
    -->
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!--
      LSRequiresIPhoneOS:
      iOS 디바이스에서만 실행되도록 설정
    -->
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!--
      UIApplicationSupportsIndirectInputEvents:
      간접 입력(페어링 키보드 등) 지원 여부
    -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!--
      UILaunchStoryboardName:
      런치 스크린으로 사용할 스토리보드 이름
    -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!--
      UIMainStoryboardFile:
      메인 스토리보드 파일 이름(Flutter 기본 구조에서는 사용 안 함)
    -->
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!--
      UISupportedInterfaceOrientations:
      iPhone에서 지원하는 화면 방향
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!--
      UISupportedInterfaceOrientations~ipad:
      iPad에서 지원하는 화면 방향
    -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

</dict>
</plist>
